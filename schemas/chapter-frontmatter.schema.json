{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gionatamassibenincasa/ci-piu-piu/schemas/chapter-frontmatter.schema.json",
  "title": "ChapterFrontmatter",
  "description": "Frontmatter YAML dei capitoli ci-piu-piu (v0.4). assessment.context, assessment.variants, components.visualization per Paper Pack v2.",
  "type": "object",
  "required": [
    "activity_id",
    "title",
    "methodology",
    "order"
  ],
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Identificativo stabile indipendente dal nome file."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "methodology": {
      "type": "string",
      "enum": [
        "PRIMM",
        "lab",
        "guide",
        "convention"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "description": "Ordinamento canonico per corso completo e prev/next."
    },
    "version": {
      "type": "string"
    },
    "last_update": {
      "type": "string",
      "format": "date"
    },
    "author": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "narrator": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "import": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "liascript_extra": {
      "type": "object",
      "additionalProperties": true
    },
    "components": {
      "type": "object",
      "description": "Dati per assignment/validazione e macro Jinja esplicite. Non sostituiscono il Markdown didattico.",
      "additionalProperties": true,
      "properties": {
        "predict_quiz": {
          "type": "object",
          "description": "Quiz Predict. Preferire items[] (una domanda MC per voce). Legacy: question+options a livello root (una sola domanda).",
          "properties": {
            "code": {
              "type": "string",
              "description": "Frammento condiviso (opzionale)"
            },
            "question": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "correct"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "correct": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "question",
                  "options"
                ],
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": [
                        "text",
                        "correct"
                      ],
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "correct": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "investigate_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modify_instructions": {
          "type": "string"
        },
        "make_instructions": {
          "type": "string"
        },
        "visualization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "table",
                "pythontutor",
                "plantuml"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "path",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "reference"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "predict",
              "run",
              "investigate",
              "modify",
              "make"
            ]
          },
          "description": {
            "type": "string"
          },
          "template_from": {
            "type": "string"
          },
          "template_content": {
            "type": "string"
          },
          "validation_rules": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min_lines": {
                "type": "integer",
                "minimum": 0
              },
              "must_contain": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "registro": {
      "type": "object",
      "description": "Testi pronti per il registro elettronico (campo Argomenti / note interne).",
      "additionalProperties": false,
      "properties": {
        "argomenti": {
          "type": "string",
          "minLength": 1,
          "description": "Testo per la sezione Argomenti/Contenuti del registro elettronico."
        },
        "note": {
          "type": "string",
          "description": "Note interne (tipo di prova, collegamento al compito digitale)."
        }
      }
    },
    "assessment": {
      "type": "object",
      "description": "Verifica formale cartacea (Paper Pack). Opzionale; se presente guida print --template paper.",
      "additionalProperties": false,
      "properties": {
        "duration_min": {
          "type": "integer",
          "minimum": 10,
          "maximum": 120
        },
        "total_points": {
          "type": "number",
          "minimum": 1
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Etichette versioni parallele (es. A, B)."
        },
        "predict": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "points": {
              "type": "number",
              "minimum": 0
            },
            "prompt": {
              "type": "string"
            },
            "context": {
              "type": "string",
              "description": "Spiegazione della risposta corretta (solo griglia docente)."
            },
            "id": {
              "type": "string",
              "description": "Override opzionale id stabile; default {activity_id}/{phase}."
            },
            "code": {
              "type": "string"
            }
          }
        },
        "investigate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "points": {
              "type": "number",
              "minimum": 0
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "typical_errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "context": {
              "type": "string",
              "description": "Spiegazione della risposta corretta (solo griglia docente)."
            },
            "id": {
              "type": "string",
              "description": "Override opzionale id stabile; default {activity_id}/{phase}."
            }
          }
        },
        "modify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "points": {
              "type": "number",
              "minimum": 0
            },
            "prompt": {
              "type": "string"
            },
            "typical_errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "context": {
              "type": "string",
              "description": "Spiegazione della risposta corretta (solo griglia docente)."
            },
            "id": {
              "type": "string",
              "description": "Override opzionale id stabile; default {activity_id}/{phase}."
            },
            "code": {
              "type": "string"
            }
          }
        },
        "make": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "points": {
              "type": "number",
              "minimum": 0
            },
            "prompt": {
              "type": "string"
            },
            "must_include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "typical_errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "context": {
              "type": "string",
              "description": "Spiegazione della risposta corretta (solo griglia docente)."
            },
            "id": {
              "type": "string",
              "description": "Override opzionale id stabile; default {activity_id}/{phase}."
            },
            "code": {
              "type": "string"
            }
          }
        },
        "variants": {
          "type": "object",
          "description": "Override per versione (A/B/...): prompt, code, questions, context diversi.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "predict": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "context": {
                    "type": "string"
                  },
                  "typical_errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "must_include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "points": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "investigate": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "context": {
                    "type": "string"
                  },
                  "typical_errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "must_include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "points": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "modify": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "context": {
                    "type": "string"
                  },
                  "typical_errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "must_include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "points": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "make": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "questions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "context": {
                    "type": "string"
                  },
                  "typical_errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "must_include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "points": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
